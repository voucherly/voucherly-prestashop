{
    "name": "voucherly/voucherly-prestashop",
    "version": "2.0.2",
    "type": "prestashop-module",
    "authors": [
        {
            "name": "Voucherly",
            "email": "info@voucherly.it"
        }
    ],
    "license": "OSL-3.0",
    "autoload": {
        "classmap": [
            "classes/"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "prepend-autoloader": false,
        "platform": {
            "php": "7.4.0"
        }
    },
    "require": {
        "voucherly/voucherly-php-sdk": "^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.12",
        "prestashop/php-dev-tools": "^4.3",
        "prestashop/autoindex": "^2.1",
        "spatie/ray": "^1.39"
    },
    "scripts": {
        "fix-code": [
            "vendor/bin/php-cs-fixer fix",
            "vendor/bin/autoindex prestashop:add:index",
            "vendor/bin/header-stamp --license=assets/gpl.txt --exclude=vendor,node_modules,tests,build --extensions=php,js,css,tpl"
        ]
    }
}
